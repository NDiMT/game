class_name QuadBatch
extends Node3D
## v1.0 (Agent A) draw-call batching for the repeated glowing quads: rune_face, halo, light_pool, floor_mark.
## Every MeshInstance3D drawn with one of those shaders on a QuadMesh / PlaneMesh is folded into ONE MultiMesh per
## shader (the *_mm.gdshader variants, generated by dev_rig/tools/make_mm_shaders.py), so N quads cost one call.
##
## Drop-in (no gameplay changes):   var qb := QuadBatch.new(); add_child(qb); qb.absorb(level_root_or_game)
##   - call absorb() once the level / puzzles are built (it can be called again for quads made later: it only
##     adds what it has not seen). The original nodes stay where they are, with their materials: they are just
##     taken off the render layers (layers = 0). Each frame QuadBatch copies their transform, visibility and
##     shader parameters into the batch, so existing code (m.set_shader_parameter("lit", ...), node.visible,
##     moving parents) keeps working unchanged.
##   - `stats()` -> {kind: count}; `release()` puts every original back (for A/B tests).
## Per-instance layout (mirrors make_mm_shaders.py): INSTANCE_CUSTOM / instance COLOR
##   rune_face  : custom (design, lit, flare, hers)   color (on_floor, numeral / 4, mirror, -)
##   floor_mark : custom (kind, intensity, sweep, fill) color (joint, hers, -, -)
##   halo       : custom (intensity, -, -, -)          color (color.r, color.g, color.b, -)
##   light_pool : custom (k, -, -, -)
## Not batched (left as they are): statue_shadow (12 per-instance values, 5 quads), quads on other meshes.
## Cost: the sync is ~6 property reads per quad per frame (about 0.1-0.2 ms for 100 quads); `sync_every` > 1 thins
## it for static scenes.

const LAYOUT := {
	"rune_face": {"c": [["design", -1.0], ["lit", 0.0], ["flare", 0.0], ["hers", 0.0]],
		"k": [["on_floor", 0.0], ["numeral", 0.0, 0.25], ["mirror", 0.0]]},
	"floor_mark": {"c": [["kind", 0.0], ["intensity", 0.0], ["sweep", 0.0], ["fill", 0.0]], "k": [["joint", 0.0], ["hers", 0.0]]},
	"halo": {"c": [["intensity", 0.4]], "k": [], "col": "color"},
	"light_pool": {"c": [["k", 1.0]], "k": []},
}

var sync_every := 1
var _batches := {}           # kind -> MultiMeshInstance3D
var _items := {}             # kind -> Array of [node, ShaderMaterial, mesh_fix Transform3D]
var _seen := {}
var _frame := 0

func absorb(root: Node) -> Dictionary:
	var found := {}
	_walk(root, found)
	for kind in found:
		if not _batches.has(kind): _make_batch(kind, found[kind][0][1])
		(_items[kind] as Array).append_array(found[kind])
		for it in found[kind]: (it[0] as MeshInstance3D).layers = 0
		_resize(kind)
	_sync(true)
	return stats()

func stats() -> Dictionary:
	var s := {}
	for kind in _items: s[kind] = (_items[kind] as Array).size()
	return s

func release() -> void:
	for kind in _items:
		for it in _items[kind]:
			if is_instance_valid(it[0]): (it[0] as MeshInstance3D).layers = 1
		(_batches[kind] as Node).queue_free()
	_items.clear(); _batches.clear(); _seen.clear()

func _walk(n: Node, found: Dictionary) -> void:
	if n is MeshInstance3D and not _seen.has(n.get_instance_id()):
		var mi := n as MeshInstance3D
		var m := mi.material_override as ShaderMaterial
		if m == null and mi.mesh: m = mi.get_surface_override_material(0) as ShaderMaterial
		if m and m.shader and mi.mesh is PlaneMesh:
			var kind := m.shader.resource_path.get_file().get_basename()
			if LAYOUT.has(kind):
				var fix := _fix(mi.mesh as PlaneMesh)
				if fix != Transform3D():
					_seen[n.get_instance_id()] = true
					if not found.has(kind): found[kind] = []
					found[kind].append([mi, m, fix])
	for c in n.get_children(): _walk(c, found)

## the unit quad (1 x 1, facing +Z) -> this node's plane / quad mesh
static func _fix(pm: PlaneMesh) -> Transform3D:
	var s := pm.size
	var o := pm.center_offset
	match pm.orientation:
		PlaneMesh.FACE_Z: return Transform3D(Basis(Vector3(s.x, 0, 0), Vector3(0, s.y, 0), Vector3(0, 0, 1)), o)
		PlaneMesh.FACE_Y: return Transform3D(Basis(Vector3(s.x, 0, 0), Vector3(0, 0, -s.y), Vector3(0, 1, 0)), o)
	return Transform3D()          # (FACE_X: not batched)

func _make_batch(kind: String, src: ShaderMaterial) -> void:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_custom_data = true
	mm.use_colors = true
	var q := QuadMesh.new()
	q.size = Vector2.ONE
	mm.mesh = q
	var mat := ShaderMaterial.new()
	mat.shader = load("res://shaders/%s_mm.gdshader" % kind)
	mat.render_priority = src.render_priority
	var mmi := MultiMeshInstance3D.new()
	mmi.name = "Batch_" + kind
	mmi.multimesh = mm
	mmi.material_override = mat
	mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mmi.top_level = true
	add_child(mmi)
	_batches[kind] = mmi
	_items[kind] = []

func _resize(kind: String) -> void:
	var mm := (_batches[kind] as MultiMeshInstance3D).multimesh
	mm.instance_count = (_items[kind] as Array).size()

func _process(_dt: float) -> void:
	_frame += 1
	if _frame % maxi(sync_every, 1) == 0: _sync(false)

func _sync(_all: bool) -> void:
	const HIDDEN := Transform3D(Basis(Vector3.ZERO, Vector3.ZERO, Vector3.ZERO), Vector3.ZERO)
	for kind in _items:
		var mm := (_batches[kind] as MultiMeshInstance3D).multimesh
		var L: Dictionary = LAYOUT[kind]
		var items: Array = _items[kind]
		for i in items.size():
			var mi: MeshInstance3D = items[i][0]
			if not is_instance_valid(mi) or not mi.is_visible_in_tree():
				mm.set_instance_transform(i, HIDDEN)
				continue
			mm.set_instance_transform(i, mi.global_transform * (items[i][2] as Transform3D))
			var m: ShaderMaterial = items[i][1]
			mm.set_instance_custom_data(i, _pack(m, L["c"]))
			if L.has("col"):
				var cv = m.get_shader_parameter(L["col"])
				var cc: Color = Color(0.2, 0.85, 1.0) if cv == null else (cv if cv is Color else Color(cv.x, cv.y, cv.z))
				mm.set_instance_color(i, Color(cc.r, cc.g, cc.b, 1.0))
			else:
				mm.set_instance_color(i, _pack(m, L["k"]))

static func _pack(m: ShaderMaterial, slots: Array) -> Color:
	var v := [0.0, 0.0, 0.0, 0.0]
	for j in slots.size():
		var s: Array = slots[j]
		var x = m.get_shader_parameter(s[0])
		var f: float = float(s[1]) if x == null else float(x)
		v[j] = f * (float(s[2]) if s.size() > 2 else 1.0)
	return Color(v[0], v[1], v[2], v[3])
