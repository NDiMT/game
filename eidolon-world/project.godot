; Engine configuration file.
config_version=5

[application]

config/name="Eidolon — The Threshold"
config/description="Atmospheric mystery and exploration in fog - first playable slice"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.07, 0.075, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
general/default_playback_type.web=1

[display]

window/size/viewport_width=400
window/size/viewport_height=860
window/size/window_width_override=420
window/size/window_height_override=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.075, 1)

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cam_back={
"type": "vec3",
"value": Vector3(0, 0.6, 0.8)
}
awaken={
"type": "float",
"value": 0.0
}
